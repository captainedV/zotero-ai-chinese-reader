{
  "manifest_version": 2,
  "name": "Zotero AI Chinese Reader (moonlit)",
  "version": "1.4.0",
  "description": "中文阅读 Zotero 里的英文论文：全文按段对照翻译、结构化总结、AI 重点标注，全部在阅读器右栏完成。",
  "author": "Zotero AI Chinese Reader contributors",
  "icons": {
    "32": "content/icons/moonlit-32.png",
    "48": "content/icons/moonlit-48.png",
    "96": "content/icons/moonlit-96.png",
    "128": "content/icons/moonlit-128.png"
  },
  "applications": {
    "zotero": {
      "id": "moonlit-reader@dsh.local",
      "update_url": "https://raw.githubusercontent.com/captainedV/zotero-ai-chinese-reader/main/docs/updates.json",
      "strict_min_version": "7.0",
      "strict_max_version": "12.99"
    }
  },
  "homepage_url": "https://github.com/captainedV/zotero-ai-chinese-reader"
}
