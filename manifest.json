{
  "manifest_version": 2,
  "name": "Moonlit Reader — AI 论文阅读助手",
  "version": "1.0.12",
  "description": "为 Zotero 阅读器打造的 AI 阅读伴侣：全文逐句对照翻译、论文总结、AI 重点标注。",
  "author": "Moonlit Reader",
  "icons": {
    "32": "content/icons/moonlit-32.png",
    "48": "content/icons/moonlit-48.png",
    "96": "content/icons/moonlit-96.png",
    "128": "content/icons/moonlit-128.png"
  },
  "applications": {
    "zotero": {
      "id": "moonlit-reader@dsh.local",
      "update_url": "https://raw.githubusercontent.com/moonlit-reader/zotero-plugin/main/updates.json",
      "strict_min_version": "7.0",
      "strict_max_version": "12.99"
    }
  },
  "homepage_url": "https://github.com/moonlit-reader/zotero-plugin"
}
